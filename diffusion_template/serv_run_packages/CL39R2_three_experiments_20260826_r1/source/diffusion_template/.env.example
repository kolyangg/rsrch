# Copy this file to diffusion_template/.env and fill in local values.
# diffusion_template/.env is ignored by Git.

COMET_API_KEY=
PM_PATH=/absolute/path/to/photomaker-v2.bin
HF_TOKEN=

# Dropbox uploader (tools/dropbox/upload_to_dropbox.py)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Dataset paths used according to CONFIG_NAME.
COSMIC_LARGE_MANIFEST=
COSMIC_LARGE_ROOT=
LARGE_DATASET_MANIFEST=
LARGE_DATASET_IMAGES=
LARGE_DATASET_EXPECTED_MANIFEST_SHA256=
BIG_CELEBS_MANIFEST=
BIG_CELEBS_IMAGES=
BIG_CELEBS_SEAL=
BIG_CELEBS_DOWNLOAD_LOG=
BIG_CELEBS_EXPECTED_MANIFEST_SHA256=
BIG_CELEBS_MIN_FACE_RES=192
BC_E13_SCHEDULE=
BC_E13_SCHEDULE_SUMMARY=
BC_E13_EXPECTED_SCHEDULE_SHA256=
SUBJECT_V2_ID_EMBEDS=../dataset_full/val_dataset/id_embeds_manual_val_subject_v2.pth
FACE_QUALITY_SCORER_PYTHON=python

# Optional operational overrides:
# COMET_PROJECT=aug-large-ds
# CUDA_VISIBLE_DEVICES=0
# PYTHON_BIN=/absolute/path/to/photomaker_NS/bin/python
# ACCELERATE_BIN=/absolute/path/to/photomaker_NS/bin/accelerate
